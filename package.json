{
  "name": "react-graphql-syntax-highlighter",
  "version": "0.1.0",
  "description": "A React component for highlighting GraphQL syntax.",
  "keywords": [
    "gql",
    "graphql",
    "react"
  ],
  "homepage": "https://github.com/simPod/react-graphql-syntax-highlighter#readme",
  "bugs": {
    "url": "https://github.com/simPod/react-graphql-syntax-highlighter/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simPod/react-graphql-syntax-highlighter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/style.css"
  ],
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "dependencies": {
    "graphql-language-service": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.0.0",
    "graphql": "^17.0.0",
    "jsdom": "^29.0.0",
    "oxfmt": "^0.79.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-compiler": "npm:typescript@^7.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "graphql": "^16.11.0 || ^17.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "packageManager": "pnpm@12.21.0"
}
